#!/bin/bash

repo_root=$(git rev-parse --show-toplevel)

if [ "$1" = "--merged" ]; then
  default_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|refs/remotes/origin/||')
  [ -z "$default_branch" ] && default_branch="main"

  while read -r path _ branch; do
    branch="${branch//[\[\]]/}"
    [ "$branch" = "detached" ] && continue
    if git branch --merged "$default_branch" | sed 's/^[* ]*//' | grep -qxF "$branch"; then
      session=$(basename "$path")
      git worktree remove --force "$path"
      tmux kill-session -t "$session" 2>/dev/null
      echo "Removed: $session"
    fi
  done < <(git worktree list | tail -n +2)
  exit 0
fi

selected=$(git worktree list | tail -n +2 | fzf | awk '{print $1}')
[ -z "$selected" ] && exit 0

session=$(basename "$selected")
git worktree remove "$selected"
tmux kill-session -t "$session" 2>/dev/null
